# ===== CineVision : configuration locale =====
# 1. Copier ce fichier : Copy-Item .env.example .env
# 2. Remplir .env avec ses propres valeurs.

# Identifiants du serveur Eureka
EUREKA_USER=eureka
EUREKA_PASSWORD=your_eureka_password

# Secret du client Keycloak movie-service (jeton de service, Client Credentials)
# Valeur de developpement : voir keycloak/realm-cinevision.json
MOVIE_SERVICE_CLIENT_SECRET=your_movie_service_client_secret

# Compte Gmail qui envoie les emails de tickets
SMTP_USERNAME=your.address@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password