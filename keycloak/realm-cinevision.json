{
  "realm": "cinevision",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "defaultRoles": [
    "CUSTOMER"
  ],
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Administrateur : gestion du catalogue"
      },
      {
        "name": "CUSTOMER",
        "description": "Client : commentaires et achats"
      },
      {
        "name": "SERVICE_MOVIE",
        "description": "Identité de service de movieService"
      }
    ]
  },
  "clients": [
    {
      "clientId": "cinevision-frontend",
      "name": "CineVision frontend (React)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "cinevision-postman",
      "name": "Client de test (Postman/PowerShell) - DEV UNIQUEMENT",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "movie-service",
      "name": "movieService",
      "enabled": true,
      "publicClient": false,
      "secret": "movie-service-dev-secret",
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "user-service",
      "name": "userService (resource server)",
      "enabled": true,
      "bearerOnly": true
    },
    {
      "clientId": "email-service",
      "name": "emailService (resource server)",
      "enabled": true,
      "bearerOnly": true
    }
  ],
  "users": [
    {
      "username": "admin@cinevision.test",
      "email": "admin@cinevision.test",
      "firstName": "Admin",
      "lastName": "CineVision",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Admin1234",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN",
        "CUSTOMER"
      ]
    },
    {
      "username": "customer@cinevision.test",
      "email": "customer@cinevision.test",
      "firstName": "Client",
      "lastName": "Test",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Test1234",
          "temporary": false
        }
      ],
      "realmRoles": [
        "CUSTOMER"
      ]
    },
    {
      "username": "service-account-movie-service",
      "enabled": true,
      "serviceAccountClientId": "movie-service",
      "realmRoles": [
        "SERVICE_MOVIE"
      ]
    }
  ]
}